# ==========================================================
# Nullik Academy - Environment Configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to version control.
# ==========================================================

# ---------- Application ----------
APP_NAME="Nullik Academy"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://nullikacademy.com
APP_KEY=base64:CHANGE_THIS_TO_A_RANDOM_32_BYTE_KEY
APP_TIMEZONE=Asia/Tehran
FORCE_HTTPS=true

# ---------- Database (MySQL 8+) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nullik_academy
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ---------- Session ----------
SESSION_NAME=nullik_session
SESSION_LIFETIME=120
SESSION_SECURE=true

# ---------- Storage paths (uploads stored OUTSIDE public root) ----------
STORAGE_PATH=storage
RECEIPTS_PATH=storage/receipts
LOGS_PATH=storage/logs

# ---------- IPPanel SMS (Pattern API) ----------
# Docs: https://docs.ippanel.com/docs/send/pattern
IPPANEL_API_KEY=
IPPANEL_BASE_URL=https://api.ippanel.com/v1
IPPANEL_SENDER=+983000505
IPPANEL_PATTERN_OTP=
IPPANEL_PATTERN_ORDER_USER=
IPPANEL_PATTERN_ORDER_ADMIN=
ADMIN_NOTIFY_MOBILE=

# ---------- Telegram Bot ----------
# Docs: https://core.telegram.org/bots/api
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SUPPORT_URL=https://t.me/nullikacademy_support

# ---------- USDT Price source ----------
USDT_PRICE_API=https://api-web.tabdeal.org/r/plots/currencies/dynamic-info/
USDT_PRICE_CACHE_TTL=600

# ---------- Payment (Card to Card) ----------
PAYMENT_CARD_NUMBER=5022-2910-0000-0000
PAYMENT_IBAN=IR000000000000000000000000
PAYMENT_ACCOUNT_NAME="مرتضی گلستانی"
PAYMENT_BANK_NAME="بانک پاسارگاد"

# ---------- OTP ----------
OTP_LENGTH=4
OTP_EXPIRY_SECONDS=120
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN=60

# ---------- Rate limiting ----------
RATE_LIMIT_OTP_PER_HOUR=8
RATE_LIMIT_LOGIN_PER_15MIN=5
RATE_LIMIT_API_PER_MIN=60
