# ==========================================================
# Nullik Academy - Public front controller rewrite rules
# ==========================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS (uncomment on production behind HTTPS)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Serve existing files/directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route everything else through index.php
    RewriteRule ^ index.php [L]
</IfModule>

# Security headers (mirrors PHP-sent headers as defense in depth)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>

# Block access to sensitive files
<FilesMatch "(^\.|composer\.(json|lock)|\.env|\.md$|\.log$)">
    Require all denied
</FilesMatch>

# Disable directory listing
Options -Indexes

# PHP hardening
<IfModule mod_php.c>
    php_flag display_errors Off
    php_value upload_max_filesize 12M
    php_value post_max_size 13M
</IfModule>
